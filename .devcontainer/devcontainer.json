{
  // O servidor da IA (servidor-ia/) no GitHub Codespaces: um computador na nuvem do GitHub, aberto pelo navegador,
  // sem instalar nada no notebook. Na conta pessoal, as horas grátis do mês dão para muitas partituras; parado
  // 30 minutos, ele desliga sozinho (e não gasta mais). Passo a passo: servidor-ia/README.md → "Na nuvem do GitHub".
  "name": "Servidor da IA do Songbook",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  // o Demucs (separar a voz) precisa de memória: a máquina de 4 núcleos e 16 GB
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  // a primeira vez instala tudo (uns 10 minutos); depois, cada vez que o Codespace liga, o servidor liga junto, sozinho
  // (puxa a versão nova, instala o que faltar por trás, deixa a porta pública ou abre o túnel e publica o endereço no
  // site: .devcontainer/servidor.sh e servidor-ia/codespace.py)
  "postCreateCommand": "bash .devcontainer/instalar.sh",
  "postStartCommand": "bash .devcontainer/ligar.sh",
  // e ao abrir o editor: se o servidor não ficou de pé ao ligar, liga agora (o ligar.sh não liga dois)
  "postAttachCommand": "bash .devcontainer/ligar.sh",
  // o gh (o programa do GitHub): para deixar a porta 7860 pública (o endereço publicado no site vai pela API, sem ele)
  "features": { "ghcr.io/devcontainers/features/github-cli:1": {} },
  "forwardPorts": [7860],
  "portsAttributes": {
    "7860": { "label": "Servidor da IA (abra para o QR code)", "onAutoForward": "silent", "visibility": "public" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["servidor-ia/README.md"] }
  }
}
