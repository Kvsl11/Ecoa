<?xml version="1.0" encoding="utf-8"?>
<!-- o widget pode ir de uma linha (4 × 1) até o quadro grande; o formato muda com o tamanho (EcoaWidget) -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="110dp"
    android:targetCellWidth="4" android:targetCellHeight="2"
    android:minResizeWidth="180dp" android:minResizeHeight="50dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_ecoa"
    android:previewLayout="@layout/widget_ecoa"
    android:description="@string/widget_descricao"
    android:widgetCategory="home_screen" />
