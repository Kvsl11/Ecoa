<!-- no lugar da capa, sem música ou sem capa: um quadro de cantos redondos com a logo do Ecoa no meio (o tamanho
     declarado faz o quadro ser quadrado e acompanhar a altura do widget) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:width="96dp" android:height="96dp">
    <shape android:shape="rectangle"><solid android:color="#33FFFFFF"/><corners android:radius="11dp"/></shape>
  </item>
  <item android:drawable="@drawable/ic_ecoa" android:width="44dp" android:height="44dp" android:gravity="center"/>
</layer-list>
