<?xml version="1.0" encoding="utf-8"?>
<!-- O widget do Ecoa: a capa à esquerda e, ao lado, o nome, o artista e os botões (como o do Spotify) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:padding="12dp" android:gravity="center_vertical"
    android:background="@drawable/widget_fundo">

    <ImageView android:id="@+id/w_capa"
        android:layout_width="96dp" android:layout_height="96dp"
        android:scaleType="centerCrop" android:contentDescription="Capa da música" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="14dp" android:gravity="center_vertical">

        <LinearLayout android:id="@+id/w_textos" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/w_titulo" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_artista" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF" android:textSize="14sp" android:maxLines="1" android:ellipsize="end"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
            <ImageButton android:id="@+id/w_anterior" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_anterior" android:background="@android:color/transparent"
                android:scaleType="centerInside" android:contentDescription="Voltar" />
            <ImageButton android:id="@+id/w_tocar" android:layout_width="52dp" android:layout_height="52dp"
                android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
                android:src="@drawable/ic_tocar" android:background="@drawable/widget_botao_play"
                android:scaleType="centerInside" android:contentDescription="Tocar" />
            <ImageButton android:id="@+id/w_proxima" android:layout_width="44dp" android:layout_height="44dp"
                android:src="@drawable/ic_proxima" android:background="@android:color/transparent"
                android:scaleType="centerInside" android:contentDescription="Pular" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
